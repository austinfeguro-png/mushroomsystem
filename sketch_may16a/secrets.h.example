// Copy this file to secrets.h and fill in local-only values before uploading.
// Set BIOSYNC_DEVICE_TOKEN to the same value in the Apache environment.
// Never commit secrets.h.
#define BIOSYNC_WIFI_SSID "replace-with-wifi-name"
#define BIOSYNC_WIFI_PASSWORD "replace-with-wifi-password"
#define BIOSYNC_DEVICE_TOKEN "replace-with-a-long-random-token"
